@model List<Dominio.Activo>

<h2>Activos</h2>

<table class="table">
    <tr>
        <th>Código</th>
        <th>Nombre</th>
        <th>Tipo</th>
        <th>Criticidad</th>
        <th>Tiene Backup</th>
        <th></th>
    </tr>

    @foreach (var a in Model)
    {
        <tr>
            <td>@a.Codigo</td>
            <td>@a.Nombre</td>
            <td>@a.TipoActivo</td>
            <td>@a.Criticidad</td>
            @if (@a.TieneBackup)
            {
                <td>Sí</td>
            }
            else
            {
                <td>No</td>
            }
            <td>
                <a asp-controller="Activo" asp-action="Desasociar" asp-route-codigo="@a.Codigo"> Desasociar</a>
            </td>
        </tr>
    }
</table>

<div class="mt-3">
    <a class="btn btn-primary"
           asp-controller="Activo"
           asp-action="Crear"
           asp-route-codigoCuenta="@ViewBag.CodigoCuenta"> 
        Crear nuevo Activo
    </a>
</div>

<br />

@if (ViewBag.Exito != null)
{
    <div class="alert alert-success">
        @ViewBag.Exito
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}